{
  "name": "mad-erp",
  "version": "1.0.0",
  "description": "Madtech Forge manufacturing ERP",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.cjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.cjs",
    "pretest:integration": "tsc",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.cjs",
    "dev:web": "node scripts/web.cjs dev",
    "build:api": "tsc",
    "build:web": "node scripts/web.cjs build",
    "db:seed": "node scripts/seed.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && npm --prefix frontend run lint",
    "verify:format-commit": "node scripts/verify-format-commit.cjs"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "private": true
}
